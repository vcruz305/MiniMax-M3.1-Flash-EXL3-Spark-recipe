# fp8-24k — 24K context, fp8 main KV (all three pools fp8).
#
# This is byte-for-byte the flag set of the measured boot 16 (2026-10-23,
# image m31-flash-exl3-spark:dev-fdd7736-a5e91ed + plugin overlay at the
# pinned rev; receipt run 20261023-113153). See README "Measured results".
#
# The fp8 pool costs 72.65 KiB/token measured (main + indexer + draft), so
# 24K is the largest fp8 context that boots; steady-state free memory ran
# 0.47-0.54 GiB, which is BELOW the default 0.5 GiB guard floor: this
# profile only completes with the operator's explicit lower-floor opt-in
# (GUARD_MEM_FLOOR_KIB=209716, what the measured boot ran). The default
# q4-32k profile serves MORE context at HIGHER steady free memory.
MAXLEN="${MAXLEN:-24576}"
KV_Q4="${KV_Q4:-0}"
KVB="${KVB:-1857000000}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
INDEXER_KV_DTYPE="${INDEXER_KV_DTYPE:-fp8}"
INDEXER_MXFP8="${INDEXER_MXFP8:-1}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-1024}"
CG_MODE="${CG_MODE:-FULL_DECODE_ONLY}"
CAPTURE_SIZES="${CAPTURE_SIZES:-1,2,3,4}"
COMPILE_MODE="${COMPILE_MODE:-0}"
MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
DSPARK="${DSPARK:-1}"
DSPARK_NUM_SPEC="${DSPARK_NUM_SPEC:-3}"
DSPARK_ATTN_BACKEND="${DSPARK_ATTN_BACKEND:-TRITON_ATTN}"
DSPARK_KV_DTYPE="${DSPARK_KV_DTYPE:-fp8}"
DSPARK_DRAFT_SAMPLE="${DSPARK_DRAFT_SAMPLE:-probabilistic}"
DSPARK_REJECTION="${DSPARK_REJECTION:-block}"
FLASHINFER_AUTOTUNE="${FLASHINFER_AUTOTUNE:-0}"
LOAD_TRIM="${LOAD_TRIM:-1}"
EMBED_ALIAS="${EMBED_ALIAS:-1}"
DRAFT_VOCAB_META="${DRAFT_VOCAB_META:-1}"
TRIM_BEFORE_KV="${TRIM_BEFORE_KV:-1}"
MOE_TEMP_ROWS="${MOE_TEMP_ROWS:-512}"
PERIODIC_TRIM_S="${PERIODIC_TRIM_S:-30}"
JIT_WARMUP_THREADS="${JIT_WARMUP_THREADS:-1}"
COMPILE_THREADS="${COMPILE_THREADS:-1}"
SERVE_WAIT="${SERVE_WAIT:-1}"
WARMUP="${WARMUP:-1}"
# Guard floor: 0.2 GiB, the value the measured boot ran. REQUIRED: this
# profile's steady-state free memory measured 0.44-0.54 GiB, BELOW the
# public default 0.5 GiB floor — the default floor would kill the serve
# under load. Do not lower it further.
GUARD_MEM_FLOOR_KIB="${GUARD_MEM_FLOOR_KIB:-209716}"
